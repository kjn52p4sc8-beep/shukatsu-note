# Server only. Copy to .env (gitignored). Never use VITE_ for these values.
MAIL_APP_URL=https://YOUR_APP.vercel.app
GOOGLE_MAIL_REDIRECT_URI=https://YOUR_APP.vercel.app/?mail_callback=1
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Generate a separate random value for each: openssl rand -base64 32
MAIL_TOKEN_KEY=
MAIL_CRON_SECRET=
# Optional: forwarded-mail receiving via Resend
MAIL_INBOUND_DOMAIN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
