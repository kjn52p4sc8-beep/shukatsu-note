# このファイルを .env という名前でコピーして、値を入れてください。
# ここに入れるのはどれも「公開してよい値」です。秘密の鍵（service_role / secret key、VAPIDの秘密鍵）は入れないでください。

# Supabase の Project URL（Project Settings → Data API）
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase の公開用キー（anon key または publishable key）
VITE_SUPABASE_ANON_KEY=

# プッシュ通知の公開鍵（npm run vapid で作った「公開鍵」）
VITE_VAPID_PUBLIC_KEY=

# Google でログインを使う場合だけ true にする（Supabase 側で Google プロバイダーの設定が必要）
# VITE_AUTH_GOOGLE=true
